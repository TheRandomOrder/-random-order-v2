---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Container from '../components/Container.astro';
import Capabilities from '../components/Capabilities.astro';
import MediaFigure from '../components/project/MediaFigure.astro';
import '../styles/projects.css';
const principles=[['Strategy before style','We start with positioning, so the identity grows from a clear understanding of the business.'],['Systems, not one-offs','The identity needs to work across packaging, signage, digital products and the decisions that follow.'],['Craft in the details','Kerning, materials and the smallest applications all contribute to how considered the brand feels.']];
---
<Base title="About — Random Order" description="A boutique brand design studio building identities from the strategy up.">
 <Hero eyebrow="About" title="A studio built" emphasis="around one idea." description="Good branding isn’t decoration applied at the end: it’s the thinking made visible. We build brands from the strategy up, so every visual decision has a reason behind it." media={false} actions={[{label:'See the work',href:'/work/'},{label:'Get in touch',href:'/contact/'}]} />
 <Container><div class="page-content">
  <section class="studio-story" aria-labelledby="story-title"><MediaFigure mediaId="about-photo" /><div><h2 id="story-title" class="eyebrow">Our story</h2><p class="lead">Identity is where a business figures out what it is saying. From chaos, comes clarity.</p><p>Random Order works with a small number of clients at a time, mostly independent, founder-led brands in hospitality, retail and wellness. Understanding the business gives the visual work a foundation that can hold together as the brand grows.</p></div></section>
  <section aria-labelledby="thinking-title"><h2 id="thinking-title" class="eyebrow" style="margin-bottom:40px">How we think</h2><div class="studio-principles">{principles.map(([title,body])=><div><h3>{title}</h3><p>{body}</p></div>)}</div></section>
  <section aria-labelledby="capabilities-title"><h2 id="capabilities-title" class="display" data-editorial-reveal style="margin-bottom:56px">Everything a brand needs<br/>to hold together.</h2><Capabilities /></section>
  <section class="page-cta"><p class="eyebrow">Start a project</p><h2 class="display">Let’s see if we’re a fit.</h2><div class="page-actions"><a class="text-link" href="/contact/">Get in touch →</a><a class="text-link" href="/work/">See the work →</a></div></section>
 </div></Container>
</Base>
