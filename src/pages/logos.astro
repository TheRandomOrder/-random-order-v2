---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Container from '../components/Container.astro';
import MediaFigure from '../components/project/MediaFigure.astro';
import {mediaAssets} from '../data/media';
import {projects,projectHref} from '../data/projects';
import '../styles/projects.css';
const marks=mediaAssets.filter(media=>media.id.startsWith('marks-'));
---
<Base title="Logos & Archive — Random Order" description="A curated wall of brandmarks from the Random Order archive.">
 <Hero eyebrow="Logos / Archive" title="A wall of" emphasis="brandmarks." description="A selection of marks built over the years, some shipped, some shelved, all part of the same way of thinking about a name." media={false} actions={[{label:'Explore the marks',href:'#marks'},{label:'View project stories',href:'/work/'}]} />
 <Container><div class="page-content"><section id="marks" aria-label="Brandmarks collection"><div class="marks-archive">{marks.map(mark=>{const parent=projects.find(project=>project.logoMediaId===mark.id);const title=mark.alt.startsWith('Brandmark from the Random Order archive')?'':mark.alt;return <article class="mark-tile"><MediaFigure mediaId={mark.id} fit="contain" caption={title??''} sizes="(max-width: 767px) 40vw, 280px" />{parent&&<a class="mark-project" href={projectHref(parent)}>{parent.title} →</a>}</article>;})}</div></section><a class="text-link" href="/work/">Explore selected work →</a></div></Container>
</Base>
