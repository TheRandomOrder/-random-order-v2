---
import Base from '../../layouts/Base.astro';
import {workSections} from '../../data/work';
import CategoryNav from '../../components/CategoryNav.astro';
import WorkIndexCard from '../../components/WorkIndexCard.astro';
import WorkHeroCarousel from '../../components/WorkHeroCarousel.astro';
import '../../styles/work-magazine.css';

const intro = 'A selection of work spanning brand identity, product design, creative direction, visual systems and experimentation. Different disciplines, approaches and scales, connected by a shared commitment to original thinking, thoughtful execution and the craft of making.';
const featuredHeroSlides = [
  {title:'Superbalist', headline:'The Art of Direction', href:'/work/superbalist/', image:'/assets/work-v2/hero-superbalist-figma.png', description:'Considering every unseen pixel to elevate the product', treatment:'direction', durationMs:8000},
  {title:'Cozy Heaven', headline:'Comfort', href:'/work/cozy-heaven/', image:'/assets/work-a/comfort-forest.jpg', description:'Considering every unseen pixel to elevate the product', treatment:'comfort', durationMs:9000},
  {title:'Metalab', headline:'Time', href:'/work/metalab/', image:'/assets/work-a/time-illustration.jpg', description:'Considering every unseen pixel to elevate the product', treatment:'time', durationMs:10000}
];
---
<Base title="Selected Work — Random Order" description={intro}>
  <WorkHeroCarousel slides={featuredHeroSlides} />

  <CategoryNav />
  <section id="all" class="work-v2-selected wrap" aria-labelledby="work-v2-selected-title">
    <div class="work-v2-index-header">
      <h2 id="work-v2-selected-title">A few things we’ve built lately</h2>
      <div class="work-v2-view-switch" role="group" aria-label="Work view">
        <button type="button" class="is-active" data-work-view="visual" aria-pressed="true" aria-controls="work-v2-visual">Grid view</button>
        <button type="button" data-work-view="list" aria-pressed="false" aria-controls="work-v2-visual">List view</button>
      </div>
    </div>
    <div class="work-v2-cards" id="work-v2-visual" data-work-index data-view="visual">
      {workSections.map(section=><section class="work-v2-group" id={section.id} data-category-section aria-labelledby={`${section.id}-title`}>
        <div class="work-section-heading"><h3 id={`${section.id}-title`}>{section.label}</h3><span class="work-v2-eyebrow">{section.cards.length} {section.cards.length===1?'project':'projects'}</span></div>
        {section.cards.map(card=><WorkIndexCard card={card} />)}
      </section>)}
    </div>
  </section>

  <section class="work-v2-further wrap" aria-labelledby="work-v2-further-title">
    <h2 id="work-v2-further-title" class="work-v2-eyebrow">Further Work</h2>
    <div class="work-v2-further-grid">
      <figure><img src="/assets/work-v2/radar.png" alt="Radar graphic study" width="427" height="320" loading="lazy" decoding="async" /><figcaption>Radar</figcaption></figure>
      <figure><img src="/assets/work-v2/lenticular.png" alt="Lenticular portrait study" width="427" height="320" loading="lazy" decoding="async" /><figcaption>Lenticular</figcaption></figure>
      <a href="/work/hallys/" aria-label="View Hally’s project"><img src="/assets/work-v2/hallys-tangle.png" alt="Hally’s Tangle artwork" width="427" height="320" loading="lazy" decoding="async" /><span>Hally’s Tangle</span></a>
    </div>
  </section>

  <section class="work-v2-magazine wrap" aria-labelledby="work-v2-magazine-title">
    <p class="work-v2-eyebrow">02 / Magazine</p>
    <h2 id="work-v2-magazine-title">A few things we’ve built lately.</h2>
    <div class="work-v2-magazine-grid" aria-hidden="true"><img src="/assets/magazine-v2/earnt.png" alt="" width="1210" height="1218" loading="lazy" /><img src="/assets/magazine-v2/feature-02.png" alt="" width="1344" height="896" loading="lazy" /><img src="/assets/magazine-v2/feature-03.png" alt="" width="1344" height="896" loading="lazy" /></div>
    <a class="work-v2-magazine-link" href="/magazine/">Explore the Magazine <span aria-hidden="true">↗</span></a>
  </section>
</Base>
<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-work-view]')];
  const index = document.querySelector<HTMLElement>('[data-work-index]');
  function setView(view:string){
    if(index) index.dataset.view=view;
    buttons.forEach(button=>{
      const active=button.dataset.workView===view;
      button.classList.toggle('is-active',active);
      button.setAttribute('aria-pressed',String(active));
    });
  }
  try { setView(localStorage.getItem('ro-work-view')==='list'?'list':'visual'); } catch {}
  buttons.forEach(button=>button.addEventListener('click',()=>{
    const view=button.dataset.workView!;
    setView(view);
    try { localStorage.setItem('ro-work-view',view); } catch {}
  }));
  const cursor=document.createElement('span');
  cursor.className='work-v2-card-cursor';
  cursor.innerHTML='<strong></strong><span>View Work +</span>';
  cursor.setAttribute('aria-hidden','true');
  document.body.append(cursor);
  document.querySelectorAll<HTMLElement>('a.work-v2-card').forEach(card=>{
    card.addEventListener('pointerenter',event=>{
      if(index?.dataset.view!=='list' && event.pointerType==='mouse' && matchMedia('(pointer:fine)').matches){
        cursor.querySelector('strong')!.textContent=card.querySelector('h4')?.textContent??'';
        cursor.classList.add('is-visible');
      }
    });
    card.addEventListener('pointermove',event=>{cursor.style.left=`${event.clientX}px`;cursor.style.top=`${event.clientY}px`;});
    card.addEventListener('pointerleave',()=>cursor.classList.remove('is-visible'));
  });
</script>
