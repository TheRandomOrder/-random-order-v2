---
import Base from '../../layouts/Base.astro';
import MediaFigure from '../../components/project/MediaFigure.astro';
import {workIndexProjects, projectHref} from '../../data/projects';
import '../../styles/projects.css';

const opening = workIndexProjects[0];
const legacy = new Set(['the-shed', 'orchard-on-long']);
const sections = [
  {title: 'Magazine', projects: workIndexProjects.filter(project => !legacy.has(project.id))},
  {title: 'Further work', projects: workIndexProjects.filter(project => legacy.has(project.id))},
];
---
<Base title="Work Index — Random Order" description="Selected work spanning brand identity, product design, creative direction, visual systems and experimentation.">
  <section class="work-list wrap" aria-labelledby="work-list-title">
    <h1 class="eyebrow" id="work-list-title">01 / Selected index</h1>
    <p class="index-intro">A selection of work spanning brand identity, product design, creative direction, visual systems and experimentation. Different disciplines, approaches and scales, connected by a shared commitment to original thinking, thoughtful execution and the craft of making.</p>
    {opening?.heroMediaId && <a class="index-cover" href={projectHref(opening)} aria-label={`Read ${opening.title}`}>
      <MediaFigure mediaId={opening.heroMediaId} preview eager showCaption={false} />
    </a>}
    {sections.map(section => <section>
      <h2 class="work-list-title" id={section.title === 'Further work' ? 'archive' : undefined}>{section.title}</h2>
      <ul class="work-list-rows">
        {section.projects.map(project => <><li><a href={projectHref(project)}>
          <span class="work-list-title">{project.title}</span>
          <span class="work-list-discipline">{project.disciplines.join(' / ')}</span>
        </a></li>
        {project.id === 'hotel-atelier' && <li class="work-list-reference"><span class="work-list-title">Design Systems</span><span class="work-list-discipline">Design systems / Methodology</span></li>}
        </>)}
      </ul>
    </section>)}
  </section>
</Base>
