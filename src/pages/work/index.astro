---
import Base from '../../layouts/Base.astro';
import {getProject, projectHref, projects} from '../../data/projects';
import {projects as homepageCards} from '../../data/home';
import WorkHeroCarousel from '../../components/WorkHeroCarousel.astro';
import '../../styles/work-magazine.css';

const intro = 'A selection of work spanning brand identity, product design, creative direction, visual systems and experimentation. Different disciplines, approaches and scales, connected by a shared commitment to original thinking, thoughtful execution and the craft of making.';
const selected = [
  {id:'ssuperlative', image:'/assets/work-v2/ssuperlative.png', alt:'Runner above the clouds'},
  {id:'golds-gym', image:'/assets/work-v2/golds-gym.png', alt:'Gold’s Gym SoCal fitness campaign'},
  {id:'hallys', image:'/assets/hallys-poster.webp', alt:'Hally’s neighbourhood café'},
  {id:'hotel-atelier', image:'/assets/work-v2/hotel-atelier.png', alt:'Hotel Atelier portrait study'},
  {id:'earnt', image:'/assets/work-v2/earnt.png', alt:'Team EARNT illustrated campaign'},
  {id:'superbalist', image:'/assets/work-v2/superbalist.png', alt:'Superbalist mobile shopping interface'},
  {id:'adidas', image:'/assets/work-v2/adidas.png', alt:'Adidas portrait campaign'},
  {id:'publicis-machine', image:'/assets/work-v2/publicis-machine.png', alt:'Publicis Machine visual campaign'},
  {id:'cozy', image:'/assets/cozy-heaven.webp', alt:'Cozy Heaven editorial image'},
  {id:'sneaker-lab', image:'/assets/work-v2/sneaker-lab-a.png', alt:'Sneaker Lab basketball campaign'},
  {id:'sussex', image:'/assets/work-v2/sussex.jpg', alt:'Sussex restaurant'},
].map(item=>{
  const currentCard = homepageCards.find(card=>card.id===item.id);
  return {...item, image:currentCard?.image??item.image, video:currentCard?.video, alt:currentCard?.alt??item.alt, project:getProject(item.id)!};
});
const featuredHeroSlides = ['superbalist','publicis-machine','hallys','golds-gym','ssuperlative','earnt'].map(id=>{
  const card=selected.find(item=>item.id===id)!;
  return {
    title:card.project.title,
    headline:id==='superbalist'?'The Art of Direction':card.project.title,
    href:projectHref(card.project)!,
    image:id==='superbalist'?'/assets/work-v2/hero-superbalist-figma.png':card.image,
    video:id==='superbalist'?undefined:card.video,
    logo:id==='superbalist'?'/assets/work-v2/superbalist-hero-logo.svg':undefined
  };
});
const figmaListOrder = ['publicis-machine','ssuperlative','golds-gym','muso','hotel-atelier','hallys','cozy','superbalist','adidas','sneaker-lab','earnt'];
const listProjects = [...projects].filter(project=>project.routeEnabled).sort((a,b)=>{
  const aIndex = figmaListOrder.indexOf(a.id);
  const bIndex = figmaListOrder.indexOf(b.id);
  return (aIndex < 0 ? Infinity : aIndex) - (bIndex < 0 ? Infinity : bIndex);
});
---
<Base title="Selected Work — Random Order" description={intro}>
  <WorkHeroCarousel slides={featuredHeroSlides} />

  <section class="work-v2-selected wrap" aria-labelledby="work-v2-selected-title">
    <p class="work-v2-eyebrow">01 / Selected index</p>
    <h2 id="work-v2-selected-title">Selected Work</h2>
    <p class="work-v2-intro">{intro}</p>
    <div class="work-v2-view-switch" role="group" aria-label="Work view">
      <button type="button" class="is-active" data-work-view="visual" aria-pressed="true" aria-controls="work-v2-visual">Visual</button>
      <button type="button" data-work-view="list" aria-pressed="false" aria-controls="work-v2-list">List</button>
    </div>
    <div class="work-v2-cards" id="work-v2-visual">
      {selected.map(({project,image,video,alt},index)=><a class:list={['work-v2-card',{'has-card-video':!!video}]} href={projectHref(project)} aria-label={`View ${project.title} project`}>
        <span class="work-v2-card-media"><img src={image} alt={alt} width="656" height="394" loading="lazy" decoding="async" />{video && <video class="card-hover-video" data-src={video} poster={image} muted playsinline preload="none" aria-hidden="true" tabindex="-1"></video>}{project.id==='hallys' && <img class="work-v2-hallys-overlay" src="/assets/projects/hallys/line-overlay.png" alt="" width="656" height="394" loading="lazy" decoding="async" />}</span>
        <span class="work-v2-card-copy"><span class="work-v2-eyebrow">{String(index+1).padStart(2,'0')}</span><span class="work-v2-eyebrow work-v2-card-category">{project.disciplines.join(' · ')}</span><strong>{project.title}</strong>{project.intro && <span class="work-v2-card-intro">{project.intro}</span>}</span>
      </a>)}
    </div>
    <div class="work-v2-list" id="work-v2-list" hidden>
      {listProjects.map(project=><a class="work-v2-list-row" href={projectHref(project)} aria-label={`View ${project.title} project`}>
        <strong>{project.title}</strong>
        <span>{project.disciplines.join(' / ')}</span>
        <span class="work-v2-list-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
  </section>

  <section class="work-v2-further wrap" aria-labelledby="work-v2-further-title">
    <h2 id="work-v2-further-title" class="work-v2-eyebrow">Further Work</h2>
    <div class="work-v2-further-grid">
      <figure><img src="/assets/work-v2/radar.png" alt="Radar graphic study" width="427" height="320" loading="lazy" decoding="async" /><figcaption>Radar</figcaption></figure>
      <figure><img src="/assets/work-v2/lenticular.png" alt="Lenticular portrait study" width="427" height="320" loading="lazy" decoding="async" /><figcaption>Lenticular</figcaption></figure>
      <a href="/work/hallys/" aria-label="View Hally’s project"><img src="/assets/work-v2/hallys-tangle.png" alt="Hally’s Tangle artwork" width="427" height="320" loading="lazy" decoding="async" /><span>Hally’s Tangle</span></a>
    </div>
  </section>

  <section class="work-v2-magazine wrap" aria-labelledby="work-v2-magazine-title">
    <p class="work-v2-eyebrow">02 / Magazine</p>
    <h2 id="work-v2-magazine-title">A few things we’ve built lately.</h2>
    <div class="work-v2-magazine-grid" aria-hidden="true"><img src="/assets/magazine-v2/earnt.png" alt="" width="1210" height="1218" loading="lazy" /><img src="/assets/magazine-v2/feature-02.png" alt="" width="1344" height="896" loading="lazy" /><img src="/assets/magazine-v2/feature-03.png" alt="" width="1344" height="896" loading="lazy" /></div>
    <a class="work-v2-magazine-link" href="/magazine/">Explore the Magazine <span aria-hidden="true">↗</span></a>
  </section>
</Base>
<script>
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-work-view]')];
  const visual = document.getElementById('work-v2-visual');
  const list = document.getElementById('work-v2-list');
  buttons.forEach(button=>button.addEventListener('click',()=>{
    const showList = button.dataset.workView === 'list';
    if (visual) visual.hidden = showList;
    if (list) list.hidden = !showList;
    buttons.forEach(item=>{
      const active = item === button;
      item.classList.toggle('is-active',active);
      item.setAttribute('aria-pressed',String(active));
    });
  }));
  const cursor=document.createElement('span');
  cursor.className='work-v2-card-cursor';
  cursor.innerHTML='<strong></strong><span>View Work +</span>';
  cursor.setAttribute('aria-hidden','true');
  document.body.append(cursor);
  document.querySelectorAll<HTMLElement>('.work-v2-card').forEach(card=>{
    card.addEventListener('pointerenter',event=>{
      if(event.pointerType==='mouse' && matchMedia('(pointer:fine)').matches){
        cursor.querySelector('strong')!.textContent=card.querySelector('strong')?.textContent??'';
        cursor.classList.add('is-visible');
      }
    });
    card.addEventListener('pointermove',event=>{cursor.style.left=`${event.clientX}px`;cursor.style.top=`${event.clientY}px`;});
    card.addEventListener('pointerleave',()=>cursor.classList.remove('is-visible'));
    const video=card.querySelector<HTMLVideoElement>('.card-hover-video');
    if(!video)return;
    const play=()=>{
      if(motionPreference.matches || !video.paused)return;
      if(!video.src)video.src=video.dataset.src??'';
      video.currentTime=0;
      void video.play().then(()=>video.setAttribute('data-playing','')).catch(()=>video.removeAttribute('data-playing'));
    };
    card.addEventListener('pointerenter',play);
    card.addEventListener('focusin',play);
    video.addEventListener('ended',()=>{video.removeAttribute('data-playing');video.currentTime=0;});
  });
</script>
