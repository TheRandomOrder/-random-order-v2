---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Container from '../components/Container.astro';
---
<Base title="Contact — Random Order" description="Tell Random Order about your next brand project.">
 <Hero eyebrow="Contact" title="Let’s start" emphasis="something." description="Tell us a bit about the project. We reply to every enquiry within two business days, even if it’s not a fit." media={false} actions={[{label:'Write an enquiry',href:'#enquiry'},{label:'Email the studio',href:'mailto:studio@therandomorder.com'}]} />
 <Container><div class="page-content"><section id="enquiry" class="enquiry-layout" aria-labelledby="enquiry-title">
  <div><h2 id="enquiry-title" class="display" style="margin-bottom:32px">Tell us about it.</h2>
  <form class="enquiry-form" data-enquiry-form action="mailto:studio@therandomorder.com" method="post" enctype="text/plain">
   <div class="enquiry-field"><label for="enquiry-name">Name</label><input id="enquiry-name" name="name" autocomplete="name" required /></div>
   <div class="enquiry-field"><label for="enquiry-email">Email</label><input id="enquiry-email" name="email" type="email" autocomplete="email" required /></div>
   <div class="enquiry-field"><label for="enquiry-company">Company <span>(optional)</span></label><input id="enquiry-company" name="company" autocomplete="organization" /></div>
   <div class="enquiry-field"><label for="enquiry-budget">Project budget</label><select id="enquiry-budget" name="budget" required><option value="">Select a range</option><option>$5,000 – $10,000</option><option>$10,000 – $25,000</option><option>$25,000 – $50,000</option><option>$50,000+</option><option>Not sure yet</option></select></div>
   <div class="enquiry-field enquiry-wide"><label for="enquiry-message">Tell us about the project</label><textarea id="enquiry-message" name="message" required></textarea></div>
   <p class="enquiry-note enquiry-wide">Prepare an email enquiry, then review and send it in your email app.</p>
   <button type="submit" class="enquiry-wide">Prepare email enquiry →</button>
   <div class="enquiry-draft enquiry-wide" data-enquiry-draft hidden><p role="status">Your enquiry is ready to review in your email app.</p><a class="email-draft-link" data-enquiry-link href="mailto:studio@therandomorder.com">Open email draft →</a><p class="enquiry-note">The enquiry is sent when you send the email.</p></div>
  </form></div>
  <aside class="enquiry-info"><div><h2>Email</h2><a href="mailto:studio@therandomorder.com">studio@therandomorder.com</a></div><div><h2>Response time</h2><p>Within two business days.</p></div><div><h2>What happens next</h2><p>We’ll reply with a few questions and, if it looks like a fit, arrange a short call.</p></div></aside>
 </section></div></Container>
 <script>
 const form=document.querySelector<HTMLFormElement>('[data-enquiry-form]');
 form?.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);const name=String(data.get('name')??'').trim(),company=String(data.get('company')??'').trim();const body=`Name: ${name}\nEmail: ${String(data.get('email')??'').trim()}\nCompany: ${company}\nBudget: ${String(data.get('budget')??'')}\n\n${String(data.get('message')??'').trim()}`;const link=document.querySelector<HTMLAnchorElement>('[data-enquiry-link]')!;link.href=`mailto:studio@therandomorder.com?subject=${encodeURIComponent('Project enquiry — '+(company||name))}&body=${encodeURIComponent(body)}`;const draft=document.querySelector<HTMLElement>('[data-enquiry-draft]')!;draft.hidden=false;link.focus();});
 </script>
</Base>
