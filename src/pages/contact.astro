---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Container from '../components/Container.astro';
---
<Base title="Contact — Random Order" description="Tell Random Order about your next brand project.">
 <Hero eyebrow="Contact" title="Let’s start" emphasis="something." description="Tell us a bit about the project. We reply to every enquiry within two business days, even if it’s not a fit." media={false} actions={[{label:'Write an enquiry',href:'#enquiry'},{label:'Email the studio',href:'mailto:studio@therandomorder.com'}]} />
 <Container><div class="page-content"><section id="enquiry" class="enquiry-layout" aria-labelledby="enquiry-title">
  <div><h2 id="enquiry-title" class="display" style="margin-bottom:32px">Tell us about it.</h2>
  <form class="enquiry-form" data-enquiry-form name="project-enquiry" action="/contact/" method="post" data-netlify="true" netlify-honeypot="bot-field">
   <input type="hidden" name="form-name" value="project-enquiry" />
   <p class="enquiry-honeypot" aria-hidden="true"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
   <div class="enquiry-field"><label for="enquiry-name">Name</label><input id="enquiry-name" name="name" autocomplete="name" required /></div>
   <div class="enquiry-field"><label for="enquiry-email">Email</label><input id="enquiry-email" name="email" type="email" autocomplete="email" required /></div>
   <div class="enquiry-field"><label for="enquiry-company">Company <span>(optional)</span></label><input id="enquiry-company" name="company" autocomplete="organization" /></div>
   <div class="enquiry-field"><label for="enquiry-budget">Project budget</label><select id="enquiry-budget" name="budget" required><option value="">Select a range</option><option>$5,000 – $10,000</option><option>$10,000 – $25,000</option><option>$25,000 – $50,000</option><option>$50,000+</option><option>Not sure yet</option></select></div>
   <div class="enquiry-field enquiry-wide"><label for="enquiry-message">Tell us about the project</label><textarea id="enquiry-message" name="message" required></textarea></div>
   <p class="enquiry-note enquiry-wide">We’ll use these details only to reply to your enquiry.</p>
   <button type="submit" class="enquiry-wide" data-enquiry-submit>Send enquiry →</button>
   <p class="enquiry-feedback enquiry-wide" data-enquiry-feedback role="status" aria-live="polite" tabindex="-1" hidden></p>
   <div class="enquiry-draft enquiry-wide" data-enquiry-fallback hidden><p>If the form doesn’t send, you can email us directly.</p><a class="email-draft-link" data-enquiry-link href="mailto:studio@therandomorder.com">Open email draft →</a></div>
  </form></div>
  <aside class="enquiry-info"><div><h2>Email</h2><a href="mailto:studio@therandomorder.com">studio@therandomorder.com</a></div><div><h2>Response time</h2><p>Within two business days.</p></div><div><h2>What happens next</h2><p>We’ll reply with a few questions and, if it looks like a fit, arrange a short call.</p></div></aside>
 </section></div></Container>
 <script>
 const form=document.querySelector<HTMLFormElement>('[data-enquiry-form]');
 form?.addEventListener('submit',async event=>{
  event.preventDefault();
  if(!form.reportValidity())return;
  const data=new FormData(form);
  const field=(key:string)=>String(data.get(key)??'').trim();
  for(const key of ['name','email','message'])data.set(key,field(key));
  const feedback=form.querySelector<HTMLElement>('[data-enquiry-feedback]')!;
  const fallback=form.querySelector<HTMLElement>('[data-enquiry-fallback]')!;
  const submit=form.querySelector<HTMLButtonElement>('[data-enquiry-submit]')!;
  const link=form.querySelector<HTMLAnchorElement>('[data-enquiry-link]')!;
  const body=`Name: ${field('name')}\nEmail: ${field('email')}\nCompany: ${field('company')}\nBudget: ${field('budget')}\n\n${field('message')}`;
  link.href=`mailto:studio@therandomorder.com?subject=${encodeURIComponent('Project enquiry — '+(field('company')||field('name')))}&body=${encodeURIComponent(body)}`;
  const show=(message:string,error=false)=>{feedback.textContent=message;feedback.dataset.error=String(error);feedback.hidden=false;feedback.focus();};
  fallback.hidden=true;
  if(!field('name')||!field('email')||!field('message')){show('Please complete the required fields before sending.',true);return;}
  if(['localhost','127.0.0.1'].includes(location.hostname)||location.hostname.endsWith('.vercel.app')){
   show('Please send this enquiry by email using the draft below.',true);
   fallback.hidden=false;
   return;
  }
  submit.disabled=true;
  submit.textContent='Sending…';
  try{
   const payload=new URLSearchParams();
   data.forEach((value,key)=>payload.append(key,String(value)));
   const response=await fetch(form.action,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:payload.toString()});
   if(!response.ok)throw new Error(`Submission failed: ${response.status}`);
   form.reset();
   show('Thank you. Your enquiry has been submitted. We’ll reply within two business days.');
  }catch{
   show('We couldn’t submit your enquiry. Please try again or send it by email.',true);
   fallback.hidden=false;
  }finally{submit.disabled=false;submit.textContent='Send enquiry →';}
 });
 </script>
</Base>
