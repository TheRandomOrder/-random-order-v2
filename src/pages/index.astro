---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import EditorialSection from '../components/EditorialSection.astro';
import StudioSections from '../components/StudioSections.astro';
import {projects} from '../data/home';
---
<Base title="Random Order — Brand Design Studio" description="Identity, strategy, and systems for founders who want their brand to feel inevitable, not interchangeable." home>
<Hero />
<EditorialSection id="work" class="selected" label="01 / Selected work"><h2 class="display">A few things <br class="mobile-only"/>we've built lately.</h2><div class="work-list">{projects.map(project=><FeaturedProject {...project} />)}</div><a class="eyebrow text-link" href="/work/">View all work →</a></EditorialSection>
<StudioSections />
<EditorialSection id="contact" class="contact" label="Start a project"><h2 class="display">Take your brand from<br/>chaos to clarity.</h2><a class="eyebrow text-link" href="/contact/">Get in touch →</a></EditorialSection>
</Base>
