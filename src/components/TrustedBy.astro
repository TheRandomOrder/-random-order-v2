---
import Container from './Container.astro';
import '../styles/homepage-interactions.css';
const clients = [
 {id:'adidas',name:'Adidas',width:517,height:503,scale:1.8},
 {id:'gadventures',name:'G Adventures',width:1218,height:277,scale:1},
 {id:'gladwin-brothers',name:'Gladwin Brothers',width:796,height:278,scale:1},
 {id:'earnt',name:'EARNT',width:1799,height:457,scale:.8},
 {id:'scott',name:'Scott USA',width:642,height:409,scale:2},
 {id:'ogilvy',name:'Ogilvy',width:1364,height:533,scale:1},
 {id:'metalab',name:'Metalab',width:1048,height:240,scale:1},
 {id:'autonomous',name:'Autonomous Health',width:1353,height:153,scale:.5},
 {id:'faria',name:'Faria Education Group',width:901,height:413,scale:1},
 {id:'nobl',name:'NOBL',width:656,height:224,scale:.9},
 {id:'pureterra',name:'PureTerra Ventures',width:716,height:546,scale:2},
 {id:'rew',name:'REW',width:239,height:56,scale:1}
];
---
<section class="trusted" aria-labelledby="trusted-title" data-node-id="1017:1523" data-logo-slider>
 <Container><h2 id="trusted-title" class="eyebrow">Trusted By</h2><button class="logo-motion-toggle" type="button" aria-controls="client-marks" aria-pressed="true" hidden>Pause logos</button></Container>
 <div id="client-marks" class="marks-strip" tabindex="0" role="region" aria-label="Selected client logos">
  <div class="marks-track">
   {[false,true].map(duplicate=><div class:list={['marks-group',{'marks-group-duplicate':duplicate}]} aria-hidden={duplicate?'true':undefined}>
    {clients.map(client=><img src={`/assets/clients/${client.id}-white.png`} alt={duplicate?'':client.name} width={client.width} height={client.height} loading="lazy" decoding="async" style={`--mark-height:clamp(${22*client.scale}px,${2.6*client.scale}vw,${34*client.scale}px)`} />)}
   </div>)}
  </div>
 </div>
 <div class="wrap location">Based in Cape Town servicing clients in Vancouver</div>
</section>
<script>
 const preference=matchMedia('(prefers-reduced-motion: reduce)');
 document.querySelectorAll<HTMLElement>('[data-logo-slider]').forEach(slider=>{
  const button=slider.querySelector<HTMLButtonElement>('.logo-motion-toggle');
  if(!button)return;
  let userPaused=false;
  function update(){
   slider.dataset.motionReady='true';
   slider.dataset.paused=String(userPaused || document.hidden);
   button!.hidden=preference.matches;
   button!.textContent=userPaused?'Play logos':'Pause logos';
   button!.setAttribute('aria-pressed',String(!userPaused));
  }
  button.addEventListener('click',()=>{userPaused=!userPaused;update();});
  preference.addEventListener('change',update);
  document.addEventListener('visibilitychange',update);
  const observer=new IntersectionObserver(([entry])=>{slider.dataset.inView=String(entry.isIntersecting);});
  observer.observe(slider);
  update();
 });
</script>
