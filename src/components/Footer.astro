---
import {navigation} from '../data/home';
import type {SiteNavigation} from '../data/site-navigation';
interface Props { siteNav?: SiteNavigation }
const {siteNav} = Astro.props;
const links = siteNav?.links ?? navigation;
---
<footer class="site-footer"><div class="wrap"><div class="footer-grid"><div class="footer-pitch"><p>Let's build something with <em>a point of view.</em></p><a class="text-link" href={siteNav?.contact ?? "/contact/"}>Start a project <img src="/assets/arrow.svg" alt="" width="14" height="14" /></a></div><div class="footer-column"><h2>Studio</h2><ul>{links.map(({label,href})=><li>{href ? <a href={href}>{label}</a> : <span>{label} (unavailable)</span>}</li>)}{siteNav?.index && <li><a href={siteNav.index}>Template index</a></li>}</ul></div><div class="footer-column footer-contact"><h2>Contact</h2>{siteNav ? <span>studio@therandomorder.com</span> : <a href="mailto:studio@therandomorder.com">studio@therandomorder.com</a>}</div><div class="footer-column"><h2>Elsewhere</h2><ul><li><span class="pending-link">Instagram</span></li><li><span class="pending-link">LinkedIn</span></li></ul></div></div><div class="footer-bottom"><a class="footer-badge" href="#main" aria-label="Back to top"><img class="badge-ring" src="/assets/badge.svg" width="78.19" height="78.19" alt="" /><img class="monogram" src="/assets/monogram.svg" alt="" /></a><p>© 2026 Random Order<span class="copyright-full">. All rights reserved.</span></p><p>Boutique brand design studio</p></div></div></footer>
