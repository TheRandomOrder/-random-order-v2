---
import type {ProjectRecord} from '../../data/projects';
import {getMedia,imageSourceSet} from '../../data/media';
import Container from '../Container.astro';
import Eyebrow from '../Eyebrow.astro';
interface Props { project: ProjectRecord }
const {project} = Astro.props;
const background = project.headerMediaId ? getMedia(project.headerMediaId) : undefined;
const metadata = project.metadata ?? [
  ...(project.client ? [{label:'Client', value:project.client}] : []),
  ...(project.year ? [{label:'Year', value:String(project.year)}] : []),
  ...(project.disciplines.length ? [{label:'Scope', value:project.disciplines.join(', ')}] : []),
];
---
<header class:list={['project-header', `project-header-${project.headerStyle ?? 'plain'}`, {'project-header-large-title':project.headerTitleScale === 'large'}]}>
  {background && <img class="project-header-background" style={`object-position:${background.position ?? 'center'};${project.headerOpacity !== undefined ? `opacity:${project.headerOpacity};` : ''}${project.headerMonochrome ? 'filter:grayscale(1);' : ''}`} src={background.type === 'video' ? background.poster : background.src} srcset={background.type==='image'?imageSourceSet(background):undefined} sizes="100vw" alt="" width={background.width} height={background.height} fetchpriority="high" decoding="async" />}
  <Container>
    <div class="project-header-body">
      <a class="project-back eyebrow" href="/work/">← Back to work</a>
      {(project.category || project.disciplines.length > 0) && <Eyebrow>{project.category ?? project.disciplines.join(' · ')}</Eyebrow>}
      <h1 data-editorial-reveal>{project.title}</h1>
      {project.intro && <p class="project-intro">{project.intro}</p>}
      {metadata.length > 0 && <dl class="project-metadata">{metadata.map(item => <div><dt class="eyebrow">{item.label}</dt><dd>{item.value}</dd></div>)}</dl>}
    </div>
    {project.headerCaption && <p class="project-header-caption">{project.headerCaption}</p>}
  </Container>
</header>
