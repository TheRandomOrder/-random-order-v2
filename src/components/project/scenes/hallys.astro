<SourceComposition width={1344} height={3711} spaceBefore={96} sourceNode="1270:14214" wide={false} align="center"><div data-node-id="1270:14214" data-name="Key moment / Branded composition" class="content-stretch flex flex-col gap-[12px] items-start overflow-clip relative shrink-0 w-[1344px]"><div data-node-id="1270:14215" class="content-stretch flex flex-col items-start relative shrink-0 w-full"><div data-node-id="1270:14216" class="content-stretch flex items-start relative shrink-0 w-full"><p data-node-id="1273:14501" class="[word-break:break-word] font-['Bebas_Neue'] leading-[1.05] not-italic relative shrink-0 text-[68px] text-black text-center tracking-[0.68px] w-[1344px]">&quot;I HAVE WORKED WITH JASON FOR OVER 10 YEARS NOW; THE LATEST PROJECT WAS THE RECENT REBRAND OF MY NEIGHBOURHOOD CAFÉ, HALLY'S. THE VISUAL NARRATIVE THAT HE LANDED ON WAS PERFECT, UNIQUE, TASTEFUL AND BOLD, MAKING US STAND OUT ACROSS ALL OF OUR CHANNELS AND COLLATERAL, AND WHICH COMPLETELY CAPTURED THE ESSENCE OF HALLY'S. JASON'S CONCEPT EXTENDED PERFECTLY TO THE WEBSITE, MENU AND BEYOND. HE IS A BRILLIANT ILLUSTRATOR TOO.&quot;</p></div></div><div data-node-id="1270:14218" class="content-stretch flex flex-col gap-[12px] items-start relative shrink-0"><div data-node-id="1270:14219" data-name="Brand Story" class="content-stretch flex flex-col gap-[18px] h-[220px] items-start overflow-clip py-[64px] relative shrink-0 w-[1344px]"><div data-node-id="1270:14220" data-name="Divider" class="h-px relative shrink-0 w-[1344px]"><img alt="" src="/assets/parity/1270-14172-6854e.svg" loading="lazy" decoding="async" class="absolute block inset-0 max-w-none size-full"></div><p data-node-id="1270:14221" class="[word-break:break-word] font-['Hanken_Grotesk'] font-bold font-bold leading-[1.6] relative shrink-0 text-[#0a0a0a] text-[length:12px] tracking-[0.96px] uppercase w-[500px]">ILLUSTRATION AND IDENTITY</p><p data-node-id="1270:14222" class="[word-break:break-word] font-['Bebas_Neue'] leading-[1.05] not-italic relative shrink-0 text-[#0a0a0a] text-[68px] tracking-[0.68px] whitespace-nowrap">A LINE THROUGH EVERYDAY LIFE.</p></div><div data-node-id="1112:497" data-name="RO / Work Detail / Copy Block / Desktop" class="content-stretch flex gap-[60px] items-start min-h-[320px] relative shrink-0 w-[1344px]"><div data-node-id="1112:493" data-name="Label" class="content-stretch flex flex-col items-start relative self-stretch shrink-0 w-[330px]"><p data-node-id="1112:494" class="[word-break:break-word] font-['Hanken_Grotesk'] font-bold font-bold leading-[1.6] relative shrink-0 text-[color:#0a0a0a] text-[length:12px] tracking-[0.96px] uppercase w-[300px]">THE WANDERING LINE</p></div><div data-node-id="1112:495" data-name="Copy" class="content-stretch flex flex-col items-start relative self-stretch shrink-0 w-[954px]"><p data-node-id="1112:496" class="[word-break:break-word] font-['Hanken_Grotesk'] font-normal leading-[1.5] relative shrink-0 text-[color:#0a0a0a] text-[length:22px] w-[930px]">Drawn like a path through the neighbourhood, the line loops around familiar objects and small café rituals. Lora’s calligraphic serif balances that informality, giving the identity a sense of refinement without losing its warmth.</p></div></div></div><p data-node-id="1270:14227" class="[word-break:break-word] font-['Hanken_Grotesk'] font-normal leading-[1.6] relative shrink-0 text-[#4a4a4d] text-[length:14px] w-[1344px]">AI image study / Existing Workbench composition</p><div data-node-id="1273:14467" data-name="poster.jpg" class="h-[1246px] relative shrink-0 w-full"><div class="absolute inset-0 overflow-hidden pointer-events-none"><img alt="Key moment / Branded composition" src="/assets/parity/1270-14172-056df.png" loading="lazy" decoding="async" class="absolute h-[94.46%] left-[-0.01%] max-w-none top-[0.04%] w-[100.01%]"></div></div><div data-node-id="1273:14469" data-name="illustration-totebag.jpg" class="h-[1204px] relative shrink-0 w-full"><div class="absolute inset-0 overflow-hidden pointer-events-none"><img alt="Key moment / Branded composition" src="/assets/parity/1270-14172-958b8.png" loading="lazy" decoding="async" class="absolute h-full left-[-1.14%] max-w-none top-0 w-[102.29%]"></div></div></div></SourceComposition>
