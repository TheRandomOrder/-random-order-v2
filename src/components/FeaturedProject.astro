---
import MediaContainer from './MediaContainer.astro';
import ProjectCardText from './ProjectCardText.astro';
import '../styles/homepage-interactions.css';
import type {projects} from '../data/home';
type Props = typeof projects[number];
const p=Astro.props;
---
<article class:list={['featured-project',`project-${p.id}`]} aria-labelledby={`project-${p.id}`}>
 <MediaContainer image={p.image} video={p.video} alt={p.alt} label={`${p.title} film`} href={p.href ?? undefined} linkLabel={`View ${p.title} project`} />
 <ProjectCardText variant="home" id={p.id} number={p.number} tags={p.tags} title={p.title} href={p.href} summary={p.summary} />
</article>
