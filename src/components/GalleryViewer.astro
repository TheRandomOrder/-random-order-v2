<dialog class="gallery-viewer" data-gallery-viewer aria-labelledby="gallery-viewer-title">
 <div class="gallery-viewer-toolbar"><h2 id="gallery-viewer-title">Image detail</h2><p data-gallery-count aria-live="polite"></p><button type="button" data-gallery-close>Close ×</button></div>
 <div class="gallery-viewer-image" data-gallery-image></div><p class="gallery-viewer-caption" data-gallery-caption></p>
 <div class="gallery-viewer-controls"><button type="button" data-gallery-previous>← Previous</button><button type="button" data-gallery-zoom aria-pressed="false">Zoom in</button><a data-gallery-original target="_blank" rel="noopener">Open original ↗</a><button type="button" data-gallery-next>Next →</button></div>
</dialog>
