---
interface Props {
  card: { id: string; title: string; category: string; description?: string; image?: string; href?: string; unavailable?: string };
  level?: 'h3' | 'h4';
  number?: number;
}
const { card, level: Heading = 'h4', number } = Astro.props;
const Tag = card.href ? 'a' : 'article';
---
<Tag class="work-v2-card" id={`project-${card.id}`} href={card.href}>
  <span class="work-v2-card-media">
    {card.image && <img src={card.image} alt="" width="770" height="394" loading="lazy" decoding="async" />}
  </span>
  <span class="work-v2-card-copy">
    {number && <span class="eyebrow card-number">{String(number).padStart(2, '0')}</span>}
    <span class="work-v2-eyebrow work-v2-card-category">{card.category}</span>
    <Heading>{card.title}</Heading>
    {card.description && <span class="work-v2-card-intro">{card.description}</span>}
    {card.href ? <span class="work-card-action">See the work</span> : card.unavailable && <span class="card-status">{card.unavailable}</span>}
  </span>
</Tag>
