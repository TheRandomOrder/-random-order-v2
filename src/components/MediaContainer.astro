---
interface Props { image:string; video?:string; hoverVideo?:boolean; alt:string; hero?:boolean; label?:string; width?:number; height?:number; sourceSet?:string; href?:string; linkLabel?:string }
const {image,video,hoverVideo=false,alt,hero=false,label='film',width,height,sourceSet,href,linkLabel}=Astro.props;
const intrinsicWidth=width??(image.includes('cozy-heaven')?1456:image.includes('sussex')?1600:656);
const srcset=sourceSet??(image.endsWith('.webp') && image.startsWith('/assets/') && !image.startsWith('/assets/projects/') ? `${image.replace('.webp','-384.webp')} 384w, ${image} ${intrinsicWidth}w` : undefined);
---
<div class="media-container" data-media>
 <img src={image} srcset={srcset} sizes={hero?'100vw':'(max-width: 767px) calc(100vw - 40px), (max-width: 1000px) 45vw, 656px'} alt={hero?'':alt} width={width??(hero?1920:656)} height={height??(hero?1200:394)} loading={hero?'eager':'lazy'} fetchpriority={hero?'high':'auto'} decoding="async" />
 {video && (hoverVideo ? <video class="card-hover-video" data-src={video} muted playsinline preload="none" aria-hidden="true" tabindex="-1" poster={image}></video> : <><video data-src={video} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" poster={image}></video><button class="media-toggle" type="button" aria-label={`Play ${label}`} aria-pressed="false" hidden>Play film</button></>)}
 {href && <a class="media-project-link" href={href} aria-label={linkLabel ?? `View ${alt}`} />}
</div>
