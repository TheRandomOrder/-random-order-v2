---
import Eyebrow from './Eyebrow.astro';
import Container from './Container.astro';
import MediaContainer from './MediaContainer.astro';
import {getMedia,imageSourceSet} from '../data/media';
interface Props { title?:string; emphasis?:string; description?:string; eyebrow?:string; mediaId?:string; media?:boolean; id?:string; actions?:{label:string,href:string}[] }
const {title,emphasis,description='Identity, strategy, and systems for founders who want their brand to feel inevitable, not interchangeable.',eyebrow='Brand Design Studio',mediaId,media=true,id,actions=[{label:'See the work',href:'#work'},{label:'Start a project',href:'/contact/'}]}=Astro.props;
const asset=mediaId?getMedia(mediaId):undefined;
---
<section class:list={['hero',{'hero-editorial':!!title}]} id={id} aria-labelledby="hero-title" data-node-id={title?undefined:'1017:679'}>
 {media && <MediaContainer hero image={asset?(asset.type==='video'?asset.poster!:asset.src):'/assets/earnt-poster.webp'} video={asset?(asset.type==='video'?asset.src:undefined):'/assets/earnt.mp4'} width={asset?.width} height={asset?.height} sourceSet={asset&&asset.type==='image'?imageSourceSet(asset):undefined} alt="" label="hero film" />}
 <Container><Eyebrow>{eyebrow}</Eyebrow><h1 id="hero-title" data-editorial-reveal>{title?<>{title}{emphasis&&<em>{emphasis}</em>}</>:<>For <br class="mobile-break"/>brands <br class="mobile-break"/>with<em>Stories <br class="mobile-break"/>to tell.</em></>}</h1><p class="hero-sub">{description}</p><div class="hero-actions">{actions.map((action,i)=><>{i>0&&<span aria-hidden="true">/</span>}<a class="text-link" href={action.href}>{action.label}</a></>)}</div></Container>
</section>
