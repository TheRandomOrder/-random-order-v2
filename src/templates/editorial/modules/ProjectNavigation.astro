---
import ProjectCardText from '../../../components/ProjectCardText.astro';
import EditorialHeading from './EditorialHeading.astro';
import MediaBlock from './MediaBlock.astro';
import type { RelatedCard, Link } from '../model';
interface Props { heading: string; cards: RelatedCard[]; back: Link }
const { heading, cards, back } = Astro.props;
---
<nav class="ed-related ed-bleed" aria-label="Project navigation">
  <div class="wrap"><EditorialHeading {heading} role="card" divider /></div>
  <ul class="ed-rail">{cards.map(card =>
    <li><a href={card.href}><MediaBlock height={412} width={552} /><ProjectCardText variant="archive" title={card.title} tags={card.tags} /></a></li>
  )}</ul>
  <div class="wrap"><a class="text-link ed-link" href={back.href}>{back.label}</a></div>
</nav>
